# Copy to .env for local runs. In CI, these are set as GitHub Actions secrets instead.

CANVAS_BASE_URL=https://canvas.instructure.com
CANVAS_TOKEN=

ICS_OUTPUT_PATH=reminders.ics
CALENDAR_NAME=HBS Prep & Deadlines

LOOKAHEAD_DAYS=60
ASSIGNMENT_REMINDER_HOUR=9
CASE_REMINDER_HOUR=18
REMINDER_DURATION_MINUTES=15
REMINDER_TIMEZONE=America/New_York

# Daily "upcoming deadlines" digest email. Leave SMTP_USERNAME blank to skip
# sending (the .ics calendar side still works without this configured).
DIGEST_WINDOW_DAYS=14
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
